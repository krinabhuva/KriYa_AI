# Application
DEBUG=True
APP_NAME=KriyaAI
APP_VERSION=1.0.0

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Database (SQLite for development)
# For production, use PostgreSQL: postgresql://user:password@localhost/kriya_ai
DATABASE_URL=sqlite:///./kriya_ai.db
DB_ECHO=False

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=your-super-secret-key-change-this-in-production-please-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# AI Services
ANTHROPIC_API_KEY=your_key_here

